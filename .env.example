# ==============================================================================
# 수형 (SOOHYUNG) / 가지톡 (GajiTalk) 멀티 프로젝트 통합 환경 변수 가이드 (.env.example)
# ==============================================================================
# 각 하위 애플리케이션(./apps/*) 디렉토리에 .env 파일을 복사하여 사용합니다.
#
# [운영 서버 원클릭 자동 생성 안내]
# 운영 서버에서는 아래 스크립트를 실행하여 4대 .env 파일을 일괄 자동 생성할 수 있습니다:
#   • ./generate_env.sh "mongodb://admin:admin123@external_project_db_mongo:27017/"
#   • npm run env:prod
#   • ./run_port.sh env
#
# 1. ./apps/admin-web  : Port 30018 (통합 관리자 웹 & 첨삭 스튜디오 - https://jupiter.axfoundly.com)
# 2. ./apps/mobile-app : Port 30019 (정원주·조경사 모바일 웹/앱 - https://saturn.axfoundly.com)
# 3. ./apps/backend    : Port 30020 (백엔드 REST API & AI/매칭 엔진 - https://uranus.axfoundly.com)
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] ./apps/backend/.env (Node.js + Express + MongoDB 서버 : Port 30020)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=30020
API_PREFIX=/api
BACKEND_URL=https://uranus.axfoundly.com
CORS_ORIGINS=https://jupiter.axfoundly.com,https://saturn.axfoundly.com,https://uranus.axfoundly.com,*

ADMIN_WEB_URL=https://jupiter.axfoundly.com
MOBILE_APP_URL=https://saturn.axfoundly.com

# MongoDB 연결 설정 (운영 컨테이너 네트워크: external_project_db_mongo)
MONGODB_URI=mongodb://admin:admin123@external_project_db_mongo:27017/soohyung?authSource=admin
MONGODB_DB_NAME=soohyung

# JWT 인증 및 보안 설정
JWT_SECRET=__SOOHYUNG_JWT_SECRET_KEY_64_CHARS_MINIMUM__
JWT_EXPIRES_IN=7d
BCRYPT_COST=10

# Vision AI & Image Inpainting 파이프라인 설정
AI_API_KEY=__VISION_AND_INPAINTING_AI_API_KEY__
VISION_AI_MODEL=gemini-2.5-pro
INPAINTING_API_URL=https://api.soohyung.ai/v1/inpaint

# 초기 시드 계정 및 샘플 데이터 설정
SEED_ADMIN_EMAIL=admin@soohyung.kr
SEED_ADMIN_PASSWORD=__SUPER_ADMIN_PASSWORD__
SEED_DEMO_DATA=true

# 오브젝트 스토리지 (원본 나무 사진 / 시뮬레이션 결과 / 시공 포트폴리오 이미지)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage

# ------------------------------------------------------------------------------
# [2] ./apps/admin-web/.env (통합 관리자 웹 & 첨삭 스튜디오 - Vite React : Port 30018)
# ------------------------------------------------------------------------------
PORT=30018
VITE_PORT=30018
VITE_APP_URL=https://jupiter.axfoundly.com
VITE_API_BASE_URL=https://uranus.axfoundly.com/api
VITE_MOBILE_APP_URL=https://saturn.axfoundly.com
VITE_APP_NAME=수형 (SOOHYUNG) 통합 관리자 & AI 첨삭 스튜디오

# ------------------------------------------------------------------------------
# [3] ./apps/mobile-app/.env (정원주 & 조경사 모바일 웹/앱 - Vite React : Port 30019)
# ------------------------------------------------------------------------------
PORT=30019
VITE_PORT=30019
VITE_APP_URL=https://saturn.axfoundly.com
VITE_API_BASE_URL=https://uranus.axfoundly.com/api
VITE_ADMIN_WEB_URL=https://jupiter.axfoundly.com
VITE_APP_NAME=수형 (SOOHYUNG) - AI 나무 전지 & 조경사 매칭
VITE_DEFAULT_MAP_LAT=37.4912
VITE_DEFAULT_MAP_LNG=127.4875
